# =============================================================================
# Variabili del bot. Copia questo file in .env (stessa cartella) e sostituisci
# REPLACE_ME con i valori veri. Il file .env non va mai su GitHub (è in .gitignore).
# Su GitHub gli stessi nomi vanno in Settings > Secrets and variables > Actions.
# =============================================================================

# ---- OBBLIGATORIO ------------------------------------------------------------
# Token del bot: https://www.metaculus.com/futureeval/participate/
METACULUS_TOKEN=REPLACE_ME

# ---- MODELLI (almeno una delle due; senza nessuna si usa il proxy Metaculus) --
# Chiave della Console Anthropic (crediti API). Attiva anche la ricerca web.
ANTHROPIC_API_KEY=REPLACE_ME
# Chiave OpenRouter dei crediti gratuiti di Metaculus (facoltativa).
# OPENROUTER_API_KEY=REPLACE_ME

# ---- RICERCA NOTIZIE (facoltativa, gratis 1.000 chiamate al mese) -------------
# https://asknews.app/
# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME

# ---- COMPORTAMENTO -----------------------------------------------------------
# Invio vero a Metaculus: lascia "no" finché non hai finito le prove.
INVIA_PREVISIONI=no
# Prova senza chiavi: risposte finte, nessuna rete. Solo per le prove locali.
# MODELLO_FINTO=si

# Tetti di spesa in dollari (predefiniti: 0.80 / 15 / 120)
# TETTO_DOMANDA_USD=0.80
# TETTO_GIORNO_USD=15
# TETTO_MESE_USD=120

# Modelli di previsione separati da virgola (predefinito: Opus 5.5 + Sonnet 5.5)
# MODELLI_PREVISIONE=anthropic/claude-opus-5-5,anthropic/claude-sonnet-5-5
